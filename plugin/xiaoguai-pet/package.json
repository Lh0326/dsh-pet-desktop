{
  "name": "dsh-xiaoguai-pet",
  "description": "小乖桌宠 for the dsh web GUI: personal sprite pet reacting to session activity (idle/thinking/working/confirm/done), with drag/pat/feed interactions, driven by per-state spritesheet tracks",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "assets/**/*", "cordis.patch.yml", "README.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "build": "esbuild src/index.ts src/client.ts --bundle --platform=node --format=esm --outdir=lib --external:@deepseek-ai/* --external:react --external:react-dom"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
